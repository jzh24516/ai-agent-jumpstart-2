{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 100 },
    "submissionId": { "type": "string", "minLength": 36, "maxLength": 36 },
    "workshopId": { "type": "string", "minLength": 36, "maxLength": 36 },
    "workshopKey": { "type": "string", "minLength": 1, "maxLength": 200 },
    "customerName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "hostName": { "type": "string", "maxLength": 200 },
    "workshopStart": { "type": "string", "maxLength": 10 },
    "workshopEnd": { "type": "string", "maxLength": 10 },
    "sourceSiteUrl": { "type": "string", "maxLength": 500 },
    "attendeeEmail": { "type": "string", "maxLength": 320 },
    "emailConsent": { "type": "boolean" },
    "submittedAt": { "type": "string", "format": "date-time" },
    "retentionExpiresAt": { "type": "string", "format": "date-time" },
    "locale": {
      "type": "string",
      "enum": ["en", "zh", "zh-HK", "zh-TW", "ja", "ko", "th", "hi", "vi"]
    },
    "overall": { "type": "integer", "minimum": 0, "maximum": 5 },
    "effort": { "type": "integer", "minimum": 0, "maximum": 5 },
    "recommend": { "type": "integer", "minimum": 0, "maximum": 5 },
    "comments": { "type": "string", "maxLength": 10000 },
    "completionPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "completedSteps": { "type": "integer", "minimum": 0 },
    "totalSteps": { "type": "integer", "minimum": 0 },
    "labStatusJson": { "type": "string", "maxLength": 100000 },
    "sourcePageUrl": { "type": "string", "maxLength": 500 },
    "userAgent": { "type": "string", "maxLength": 500 },
    "processingVersion": { "type": "string", "maxLength": 50 }
  },
  "required": [
    "schemaVersion",
    "submissionId",
    "workshopId",
    "workshopKey",
    "customerName",
    "hostName",
    "workshopStart",
    "workshopEnd",
    "sourceSiteUrl",
    "attendeeEmail",
    "emailConsent",
    "submittedAt",
    "retentionExpiresAt",
    "locale",
    "overall",
    "effort",
    "recommend",
    "comments",
    "completionPercent",
    "completedSteps",
    "totalSteps",
    "labStatusJson",
    "sourcePageUrl",
    "userAgent",
    "processingVersion"
  ]
}
