              "item/mjsrc_recommend": "@triggerBody()?['recommend']",
              "item/mjsrc_comments": "@triggerBody()?['comments']",
              "item/mjsrc_completionpercent": "@triggerBody()?['completionPercent']",
              "item/mjsrc_completedsteps": "@triggerBody()?['completedSteps']",
              "item/mjsrc_totalsteps": "@triggerBody()?['totalSteps']",
              "item/mjsrc_labstatusjson": "@triggerBody()?['labStatusJson']",
