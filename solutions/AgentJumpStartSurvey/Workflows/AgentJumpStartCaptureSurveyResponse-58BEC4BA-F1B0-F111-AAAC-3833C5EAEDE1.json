              "item/mjsrc_processingversion": "@triggerBody()?['processingVersion']",
              "item/mjsrc_WorkshopId@odata.bind": "@concat('/mjsrc_workshops(', triggerBody()?['workshopId'], ')')",
              "accept": "application/json;odata.metadata=minimal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Return_Success": {
          "runAfter": {
