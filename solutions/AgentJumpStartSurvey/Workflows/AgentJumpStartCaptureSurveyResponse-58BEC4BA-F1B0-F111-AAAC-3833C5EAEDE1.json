              "item/mjsrc_workshopkey": "@triggerBody()?['workshopKey']",
              "item/mjsrc_customername": "@triggerBody()?['customerName']",
              "item/mjsrc_attendeeemail": "@if(equals(triggerBody()?['emailConsent'], true), triggerBody()?['attendeeEmail'], '')",
              "item/mjsrc_emailconsent": "@triggerBody()?['emailConsent']",
              "item/mjsrc_submittedat": "@triggerBody()?['submittedAt']",
